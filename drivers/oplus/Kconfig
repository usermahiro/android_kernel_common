menu "OPLUS Features"

config OPLUS_FEATURE
	bool "OPLUS Features"
	default y

config OPLUS_NANDSWAP
	bool "OPLUS nandswap support"
	depends on SWAP
	default y
	help
	  This option enables OPLUS nandswap feature for ColorOS RAM Expansion.

endmenu

config OPLUS_HEALTHINFO
	bool "OPLUS healthinfo support"
	default y
	help
	  This option enables OPLUS healthinfo procfs interface (/proc/oplus_healthinfo)
	  for ColorOS performance and system resource management.

config OPLUS_DEVINFO
	bool "OPLUS device info support"
	default y
	help
	  This option enables the OPlus device info interface (/proc/devinfo).
	  It dynamically discovers attached block storage (UFS/eMMC) and system
	  memory (DDR type/capacity) using standard Linux kernel subsystems.

config OPLUS_SCHED_ASSIST
	bool "OPLUS sched assist support"
	default y
	help
	  This option enables the OPlus scheduler assist interface located at
	  /proc/oplus_scheduler/sched_assist. It provides real-time scene-based
	  CPU frequency QoS boosting and dynamic CFS nice acceleration for
	  user-experience (UX) and critical application threads.
